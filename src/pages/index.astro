---
import Layout from '../components/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Skills from '../components/Skills.astro';
import EducationGoals from '../components/EducationGoals.astro';
import Contact from '../components/Contact.astro';
import ScrollPath from '../components/ScrollPath.astro';
import { site } from '../data/site';
---

<Layout title={site.title} description={site.description}>
  <Nav />
  <ScrollPath />
  <main id="main-content">
    <div class="parallax-layer" style="--parallax-speed: 0;">
      <Hero />
    </div>
    <div class="parallax-layer" style="--parallax-speed: 0.1;">
      <About />
    </div>
    <div class="parallax-layer" style="--parallax-speed: 0.15;">
      <Experience />
    </div>
    <div class="parallax-layer" style="--parallax-speed: 0.2;">
      <ProjectGrid />
    </div>
    <div class="parallax-layer" style="--parallax-speed: 0.25;">
      <Skills />
    </div>
    <div class="parallax-layer" style="--parallax-speed: 0.3;">
      <EducationGoals />
    </div>
    <div class="parallax-layer" style="--parallax-speed: 0.1;">
      <Contact />
    </div>
  </main>
  <footer class="footer">
    <div class="container footer__inner">
      <p class="footer__copy">
        &copy; {new Date().getFullYear()} {site.name}. Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>.
      </p>
      <p class="footer__note">v1 — Lusion-inspired</p>
    </div>
  </footer>
</Layout>

<style>
  .footer {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .footer__copy {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .footer__copy a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .footer__copy a:hover {
    text-decoration: underline;
  }

  .footer__note {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    opacity: 0.6;
  }

  @media (max-width: 480px) {
    .footer__inner {
      flex-direction: column;
      text-align: center;
      gap: var(--space-2);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Advanced Lusion-style GSAP Scroll Reveals
  function initScrollReveals() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      document.querySelectorAll('[data-motion]').forEach((el) => {
        el.classList.add('is-revealed');
      });
      return;
    }

    // 1. Text fades & slight upward movement
    const textElements = document.querySelectorAll('p[data-motion], h2[data-motion], h3[data-motion], span[data-motion]');
    textElements.forEach((el) => {
      gsap.fromTo(el, 
        { autoAlpha: 0, y: 40, rotationX: -15, transformPerspective: 500 },
        { 
          autoAlpha: 1, y: 0, rotationX: 0,
          duration: 1.2, 
          ease: 'power3.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 85%',
            toggleActions: 'play none none reverse'
          }
        }
      );
    });

    // 2. Cards Staggered Animation
    // Group cards by their parent container to stagger them beautifully
    const cardContainers = document.querySelectorAll('.project-grid, .about__content, .experience__list');
    cardContainers.forEach((container) => {
      const cards = container.querySelectorAll('.project-card, .about__card, .experience__item');
      if (cards.length > 0) {
        gsap.fromTo(cards,
          { autoAlpha: 0, y: 60, scale: 0.95 },
          {
            autoAlpha: 1, y: 0, scale: 1,
            duration: 1.2,
            stagger: 0.15,
            ease: 'back.out(1.2)', // bouncy Lusion feel
            scrollTrigger: {
              trigger: container,
              start: 'top 80%',
              toggleActions: 'play none none reverse'
            }
          }
        );
      }
    });

    // 3. Any other data-motion elements
    const otherElements = document.querySelectorAll('[data-motion]:not(p):not(h2):not(h3):not(span)');
    otherElements.forEach((el) => {
      if (el.closest('.project-grid') || el.closest('.about__content') || el.closest('.experience__list')) return; // handled by stagger
      
      gsap.fromTo(el,
        { autoAlpha: 0, y: 30 },
        {
          autoAlpha: 1, y: 0,
          duration: 1,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 85%',
            toggleActions: 'play none none reverse'
          }
        }
      );
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollReveals);
  } else {
    initScrollReveals();
  }

  // Parallax effect for HTML sections
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  
  if (!prefersReducedMotion) {
    const layers = document.querySelectorAll<HTMLElement>('.parallax-layer');
    const skewElements = document.querySelectorAll<HTMLElement>('.project-card, .about__card, .experience__item');

    let currentScroll = window.scrollY;
    let targetScroll = window.scrollY;

    function lerp(start: number, end: number, factor: number) {
      return start + (end - start) * factor;
    }

    function rafLoop() {
      targetScroll = window.scrollY;
      currentScroll = lerp(currentScroll, targetScroll, 0.1);
      
      const velocity = targetScroll - currentScroll;
      let normalizedV = Math.abs(velocity) / 50;
      normalizedV = Math.min(Math.max(normalizedV, 0), 1);
      const skewAngle = normalizedV * 1.5 * Math.sign(velocity); // Max 1.5 degrees

      layers.forEach(layer => {
        const speed = parseFloat(layer.style.getPropertyValue('--parallax-speed') || '0');
        if (speed !== 0) {
          layer.style.transform = `translateY(${targetScroll * speed * -1}px)`;
        }
      });

      skewElements.forEach(el => {
        // preserve other transforms if needed, but for these cards, overriding is okay
        el.style.transform = `skewY(${skewAngle}deg)`;
      });

      requestAnimationFrame(rafLoop);
    }
    
    requestAnimationFrame(rafLoop);
  }
</script>
